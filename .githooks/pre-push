#!/usr/bin/env bash
set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

if [[ -n "$(git status --porcelain --untracked-files=normal)" ]]; then
  echo "推送前门禁要求工作树干净；请先提交或移走未提交改动。" >&2
  exit 1
fi

head_sha="$(git rev-parse HEAD)"
checked=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ "$local_ref" == refs/heads/* ]] || continue
  [[ "$local_sha" =~ ^0+$ ]] && continue
  if [[ "$local_sha" != "$head_sha" ]]; then
    echo "一次只推送当前检出的分支，避免验证结果与推送提交不一致。" >&2
    exit 1
  fi
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    echo "无法从远端旧提交确定变更基线；请先拉取目标分支再推送。" >&2
    exit 1
  fi
  if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
    echo "拒绝非快进推送；先同步远端分支，再重新验证。" >&2
    exit 1
  fi

  echo "推送前检查：$remote_ref 从 ${remote_sha:0:12} 到 ${local_sha:0:12}"
  npm run lint:changes -- "$remote_sha"
  npm run gate:related -- "$remote_sha"
  checked=1
done

if (( checked == 0 )); then
  echo "本次没有待推送的分支提交，跳过代码门禁。"
fi
