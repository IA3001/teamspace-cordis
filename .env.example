# 标准环境变量模板 —— 复制成 .env 使用（.env 不入库）
#
#   cp .env.example .env
#
# ⚠ 端口只在这里定义一次，是全系统**唯一出处**：
#   代码入口、cordis.yml、scripts/ 全部从这里取值（cordis.yml 用 !!js 读 process.env）。
#   禁止在别处再写死端口 —— 上一版 teamspace 就是端口散落多处而对不齐
#   （dev.sh=18080、hotdev 后端=8080、生产=8080），这条规矩就是冲着那个教训立的。

# ── 服务监听 ────────────────────────────────────────────────────────────
# 后端（API + 静态资源）监听地址。
# WSL2 有独立网络命名空间：**必须绑 0.0.0.0**，否则 Windows 浏览器
# 用 localhost 连不上（表现为"拒绝连接"，很容易误判成服务挂了）。
APP_HOST=0.0.0.0
APP_PORT=8080

# ── 前端 dev server（给 Vite 用；生产由后端在 APP_PORT 上同端口提供）────
# 调试控制台：插件 / 日志 / 数据库三个查看页，测试用、无登录、直达（见 docs/ROADMAP.md M1）
# ⚠ 这是**新开**的端口，与下面的正式控制台（CONSOLE_PORT）**并存**，不是替换它。
DEBUG_PORT=5172
CONSOLE_PORT=5173
TEAMSPACE_PORT=5174
# Optional public API origin behind a TLS reverse proxy, e.g. https://team.example.com.
# The proxy routes /api/* to APP_PORT and Teamspace pages/WebSocket to TEAMSPACE_PORT.
# If unset, the browser reaches APP_PORT directly on the same hostname.
TEAMSPACE_API_BASE_URL=

# ── 运行 ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai
# Production workdir claims fail closed unless the fixed, root-owned XFS quota helper is installed.
# WORKDIR_QUOTA_HELPER=/usr/local/sbin/teamspace-workdir-quota
# WORKDIR_QUOTA_SUDO=1
# Optional override when the Node >=22.5 binary is not the default on PATH.
# NODE_BIN_DIR=/usr/bin
# ── 文字模型（后台配置优先；以下变量用于部署兜底）───────────────────────
# OpenAI 兼容 Chat Completions。完整配置后 brain-llm 负责协调决策与 Agent 回复；
# 未配置时启用诚实标注的占位协调者。后台保存的 API 配置优先于这些环境变量。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Embedding（文本向量，2026-10-01）────────────────────────────────────
# OpenAI 兼容 /embeddings 接口；**可与 LLM 不同供应商**（独立一套 env）。
# 也可在 5172 配置面板（space-embedding-openai）里填，面板值优先、此处兜底。
# 缺省模型 text-embedding-3-small。
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# SQLite 中 LLM / Embedding / 搜索 API 凭据的加密密钥（32 字节）。
# 每个部署生成并妥善备份一次；不可提交，也不能与数据库备份放在同一公开位置。
# 生成：openssl rand -base64 32
SETTINGS_ENCRYPTION_KEY=

# 文字模型和 Embedding 可用后台配置页或以上环境变量配置；网页搜索 API
# 目前通过后台配置页管理。三类服务彼此独立，不要依赖外接 API 网关。
