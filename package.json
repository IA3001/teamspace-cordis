{
  "name": "teamspace-cordis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多人 + 多 Agent 团队协作系统 —— 基于 cordis 元框架，一切皆插件",
  "license": "MIT",
  "main": "src/index.ts",
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "start": "./scripts/run.sh",
    "dev": "./scripts/dev.sh",
    "stop": "./scripts/stop.sh",
    "typecheck": "tsc --noEmit && node scripts/record-action.mjs typecheck",
    "lint:styles": "./scripts/lint-styles.sh",
    "lint:deps": "./scripts/lint-deps.sh",
    "lint:patch": "./scripts/lint-patch.sh",
    "check:console": "./scripts/check-console.sh",
    "migrate": "tsx scripts/store.ts up",
    "migrate:down": "tsx scripts/store.ts down",
    "seed": "tsx scripts/store.ts seed",
    "reset": "tsx scripts/store.ts reset",
    "lint:migrations": "./scripts/lint-migrations.sh",
    "lint:observe": "./scripts/lint-observability.sh",
    "gate": "npm run typecheck && npm run lint:deps && npm run lint:patch && npm run lint:migrations && npm run lint:styles && npm run check:console && npm run check:web && npm run verify:staging && npm run verify:orchestrator && npm run verify:agents && npm run verify:workdir && npm run verify:p8 && npm run lint:observe",
    "verify:staging": "tsx scripts/verify-staging.ts",
    "verify:orchestrator": "tsx scripts/verify-orchestrator.ts",
    "verify:agents": "tsx scripts/verify-agents.ts",
    "build:web": "./scripts/build-web.sh",
    "check:web": "./scripts/check-web.sh",
    "verify:workdir": "tsx scripts/verify-workdir.ts",
    "verify:p8": "tsx scripts/verify-p8.ts"
  },
  "dependencies": {
    "@cordisjs/client": "^0.8.2",
    "@cordisjs/plugin-database": "^4.1.1",
    "@cordisjs/plugin-database-sqlite": "^5.1.1",
    "@cordisjs/plugin-database-webui": "^0.5.0",
    "@cordisjs/plugin-include": "^1.1.0",
    "@cordisjs/plugin-loader": "^1.0.0-rc.7",
    "@cordisjs/plugin-loader-webui": "^0.10.1",
    "@cordisjs/plugin-logger-webui": "^0.6.1",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@cordisjs/plugin-webui": "^0.8.2",
    "cordis": "^4.0.0-rc.10",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
