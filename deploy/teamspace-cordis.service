[Unit]
Description=Teamspace Cordis collaboration service
Wants=network-online.target
After=network-online.target
# Do not start against the root filesystem if the dedicated workspace volume is absent.
RequiresMountsFor=/srv/teamspace-cordis/data/workdirs
ConditionPathIsMountPoint=/srv/teamspace-cordis/data/workdirs

[Service]
Type=simple
User=teamspace
Group=teamspace
# For the system Docker daemon; remove this when using rootless Docker.
SupplementaryGroups=docker
# Keep the checkout and data directory at a stable path across releases.
WorkingDirectory=/srv/teamspace-cordis
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5s
TimeoutStopSec=45s
UMask=0077
# Release code and built UI are immutable at runtime; the generated plugin manifest and state are writable.
ReadOnlyPaths=/srv/teamspace-cordis
ReadWritePaths=/srv/teamspace-cordis/data
ReadWritePaths=/srv/teamspace-cordis/composed.cordis.yml
StandardOutput=journal
StandardError=journal
PrivateTmp=true

[Install]
WantedBy=multi-user.target
