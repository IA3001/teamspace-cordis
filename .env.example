# 标准环境变量模板 —— 复制成 .env 使用（.env 不入库）
#
#   cp .env.example .env
#
# ⚠ 端口只在这里定义一次，是全系统**唯一出处**：
#   代码入口、cordis.yml、scripts/ 全部从这里取值（cordis.yml 用 !!js 读 process.env）。
#   禁止在别处再写死端口 —— 上一版 teamspace 就是端口散落多处而对不齐
#   （dev.sh=18080、hotdev 后端=8080、生产=8080），这条规矩就是冲着那个教训立的。

# ── 服务监听 ────────────────────────────────────────────────────────────
# 后端（API + 静态资源）监听地址。
# WSL2 有独立网络命名空间：**必须绑 0.0.0.0**，否则 Windows 浏览器
# 用 localhost 连不上（表现为"拒绝连接"，很容易误判成服务挂了）。
APP_HOST=0.0.0.0
APP_PORT=8080

# ── 前端 dev server（给 Vite 用；生产由后端在 APP_PORT 上同端口提供）────
# 调试控制台：插件 / 日志 / 数据库三个查看页，测试用、无登录、直达（见 docs/ROADMAP.md M1）
# ⚠ 这是**新开**的端口，与下面的正式控制台（CONSOLE_PORT）**并存**，不是替换它。
DEBUG_PORT=5172
CONSOLE_PORT=5173
TEAMSPACE_PORT=5174

# ── 运行 ────────────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
TZ=Asia/Shanghai
# ── LLM（真大脑接口位，P8 预留）─────────────────────────────────────────
# 占位大脑（plugins/brain-stub）只读不调：即使配置了 LLM_API_KEY 也仍走占位
# 决策 —— 真 LLM 适配器等模型 key 与 4 角色提示词原文到位后接入。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── Embedding（文本向量，2026-10-01）────────────────────────────────────
# OpenAI 兼容 /embeddings 接口；**可与 LLM 不同供应商**（独立一套 env）。
# 也可在 5172 配置面板（space-embedding-openai）里填，面板值优先、此处兜底。
# 缺省模型 text-embedding-3-small。
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=

# ── 模型网关（可选，推荐）──────────────────────────────────────────────
# 上面的 LLM_*/EMBED_* 可以全部指向一个 new-api 网关（供应商管理外移）：
#   docker compose -f deploy/docker-compose.newapi.yml up -d   # 起网关(端口3000)
#   管理页 http://localhost:3000 配渠道+签令牌，然后：
#   LLM_BASE_URL=http://localhost:3000/v1   LLM_API_KEY=sk-网关令牌   LLM_MODEL=网关里的模型名
#   EMBED_* 同理。详见 deploy/docker-compose.newapi.yml 头部注释。
