{
  "name": "teamspace-cordis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "多人 + 多 Agent 团队协作系统 —— 基于 cordis 元框架，一切皆插件",
  "license": "MIT",
  "main": "src/index.ts",
  "engines": {
    "node": ">=22.5.0"
  },
  "workspaces": [
    "packages/*/*"
  ],
  "scripts": {
    "start": "./scripts/run.sh",
    "dev": "./scripts/dev.sh",
    "stop": "./scripts/stop.sh",
    "typecheck": "tsc --noEmit && node scripts/record-action.mjs typecheck",
    "lint:styles": "./scripts/lint-styles.sh",
    "lint:deps": "./scripts/lint-deps.sh",
    "lint:patch": "./scripts/lint-patch.sh",
    "check:console": "./scripts/check-console.sh",
    "migrate": "tsx scripts/store.ts up",
    "migrate:down": "tsx scripts/store.ts down",
    "seed": "tsx scripts/store.ts seed",
    "reset": "tsx scripts/store.ts reset",
    "lint:migrations": "./scripts/lint-migrations.sh",
    "lint:observe": "./scripts/lint-observability.sh",
    "gate": "npm run gate:static && npm run gate:runtime",
    "verify:orchestrator": "tsx scripts/verify-orchestrator.ts",
    "verify:orchestrator:core": "tsx scripts/verify-orchestrator.ts --core-only",
    "verify:flow-recovery": "tsx scripts/verify-flow-recovery.ts && node scripts/record-action.mjs verify-flow-recovery",
    "verify:agents": "npm run verify:agent-teamspace",
    "build:web": "./scripts/build-web.sh",
    "check:web": "./scripts/check-web.sh",
    "verify:workdir": "tsx scripts/verify-workdir.ts",
    "verify:workdir-quota": "python3 scripts/verify-workdir-quota.py && node scripts/record-action.mjs verify-workdir-quota",
    "verify:p8": "tsx scripts/verify-p8.ts",
    "backup": "./scripts/backup.sh",
    "smoke": "./scripts/smoke.sh",
    "wait:runtime-idle": "node scripts/wait-runtime-idle.mjs && node scripts/record-action.mjs wait-runtime-idle",
    "verify:ui": "node scripts/ui-verify.mjs && node scripts/record-action.mjs verify-ui",
    "gate:static": "npm run typecheck && npm run verify:workdir-quota && npm run lint:deps && npm run lint:patch && npm run lint:migrations && npm run lint:styles && npm run verify:admin-auth && npm run verify:admin-plugins && npm run verify:settings-encryption && npm run verify:session-members && npm run verify:session-access && npm run verify:upload-access && npm run verify:session-work && npm run verify:agent-speech && npm run verify:agent-catalog && npm run verify:agent-bootstrap && npm run verify:agent-teamspace && npm run verify:agent-inbox && npm run verify:inbox-orchestrator-mix && npm run verify:flow-recovery && npm run verify:rag && npm run verify:rag-project && npm run verify:decision-commands && npm run verify:author-recall && npm run verify:empty-message && npm run verify:web-search && npm run verify:llm-stream && npm run verify:backup-restore && npm run lint:observe",
    "gate:runtime": "npm run check:console && npm run check:web && npm run wait:runtime-idle && npm run verify:orchestrator && npm run verify:workdir && npm run verify:p8 && npm run verify:sandbox && npm run wait:runtime-idle && npm run smoke && npm run verify:ui && npm run verify:admin-ui",
    "verify:agent-catalog": "tsx scripts/verify-agent-catalog.ts && node scripts/record-action.mjs verify-agent-catalog",
    "verify:admin-auth": "tsx scripts/verify-admin-auth.ts",
    "verify:admin-ui": "node scripts/admin-ui-verify.mjs && node scripts/record-action.mjs verify-admin-ui",
    "verify:llm-stream": "tsx scripts/verify-llm-stream.ts && node scripts/record-action.mjs verify-llm-stream",
    "verify:backup-restore": "tsx scripts/verify-backup-restore.ts && node scripts/record-action.mjs verify-backup-restore",
    "verify:admin-plugins": "tsx scripts/verify-admin-plugins.ts",
    "verify:settings-encryption": "tsx scripts/verify-settings-encryption.ts && node scripts/record-action.mjs verify-settings-encryption",
    "verify:session-members": "tsx scripts/verify-session-members.ts && node scripts/record-action.mjs verify-session-members",
    "verify:session-access": "tsx scripts/verify-session-access.ts && node scripts/record-action.mjs verify-session-access",
    "verify:upload-access": "tsx scripts/verify-upload-access.ts && node scripts/record-action.mjs verify-upload-access",
    "verify:session-work": "tsx scripts/verify-session-work.ts && node scripts/record-action.mjs verify-session-work",
    "verify:agent-speech": "tsx scripts/verify-agent-speech.ts && node scripts/record-action.mjs verify-agent-speech",
    "verify:rag": "tsx scripts/verify-rag.ts && node scripts/record-action.mjs verify-rag",
    "verify:agent-teamspace": "tsx scripts/verify-agent-teamspace.ts && node scripts/record-action.mjs verify-agent-teamspace",
    "verify:agent-inbox": "tsx scripts/verify-agent-inbox.ts && node scripts/record-action.mjs verify-agent-inbox",
    "verify:inbox-orchestrator-mix": "tsx scripts/verify-inbox-orchestrator-mix.ts && node scripts/record-action.mjs verify-inbox-orchestrator-mix",
    "verify:decision-commands": "tsx scripts/verify-decision-commands.ts && node scripts/record-action.mjs verify-decision-commands",
    "verify:author-recall": "tsx scripts/verify-author-recall.ts && node scripts/record-action.mjs verify-author-recall",
    "verify:empty-message": "tsx scripts/verify-empty-message.ts && node scripts/record-action.mjs verify-empty-message",
    "verify:sandbox": "tsx scripts/verify-sandbox-tools.ts && node scripts/record-action.mjs verify-sandbox",
    "verify:web-search": "tsx scripts/verify-web-search.ts",
    "evaluate:rag-project": "tsx scripts/evaluate-rag-project.ts",
    "evaluate:rag-project:embeddings": "node --env-file=.env --import tsx scripts/evaluate-rag-project.ts --with-embeddings",
    "verify:rag-project": "tsx scripts/evaluate-rag-project.ts && node scripts/record-action.mjs verify-rag-project",
    "verify:agent-bootstrap": "tsx scripts/verify-agent-bootstrap.ts && node scripts/record-action.mjs verify-agent-bootstrap"
  },
  "dependencies": {
    "@cordisjs/client": "^0.8.2",
    "@cordisjs/plugin-database": "^4.1.1",
    "@cordisjs/plugin-database-sqlite": "^5.1.1",
    "@cordisjs/plugin-database-webui": "^0.5.0",
    "@cordisjs/plugin-include": "^1.1.0",
    "@cordisjs/plugin-loader": "^1.0.0-rc.7",
    "@cordisjs/plugin-loader-webui": "^0.10.1",
    "@cordisjs/plugin-logger-webui": "^0.6.1",
    "@cordisjs/plugin-server": "^1.7.0",
    "@cordisjs/plugin-timer": "^1.1.3",
    "@cordisjs/plugin-webui": "^0.8.2",
    "cordis": "^4.0.0-rc.10",
    "js-yaml": "^5.4.2"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.3",
    "playwright-core": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
